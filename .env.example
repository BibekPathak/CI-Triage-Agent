# ---- LLM ----
# Provider: "openai" (default) or "deterministic" (offline/test)
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=90
MAX_TOKENS=2048

# ---- Budgets / guardrails ----
MAX_ITERATIONS=20
MAX_TOOL_CALLS=50
MAX_EXECUTION_SECONDS=900
MAX_TOKENS_TOTAL=200000
EST_COST_PER_1K_IN=0.005
EST_COST_PER_1K_OUT=0.015

# ---- Sandbox ----
# backend: "docker" (default) or "local" (process runner, for tests/demo)
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=ci-triage-sandbox:dev
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_COMMAND_TIMEOUT=120
SANDBOX_NETWORK=false
SANDBOX_PULL=true

# ---- GitHub ----
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# ---- Persistence ----
# sqlite (default) or postgres, e.g.
# postgresql+psycopg://user:pass@localhost:5432/triage
DATABASE_URL=sqlite:///./data/triage.db

# ---- Approval / change policy ----
CHANGED_FILES_THRESHOLD=10
# "manual" (default) | "auto"
APPROVE_MODE=manual
